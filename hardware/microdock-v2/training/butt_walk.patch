+def test_undock_shaping_and_critic_obs_are_opt_in(monkeypatch):
+    for k in ("MICRODUCK_BW_UNDOCK_PROGRESS", "MICRODUCK_BW_UNDOCK_CRITIC"):
+        monkeypatch.delenv(k, raising=False)
+    cfg = _cfg(monkeypatch, MICRODUCK_BW_UNDOCK="0.3")
+    assert "undock_progress" not in cfg.rewards and "undock" not in cfg.observations["critic"].terms
+    cfg = _cfg(monkeypatch, MICRODUCK_BW_UNDOCK="0.3", MICRODUCK_BW_UNDOCK_PROGRESS="1.0", MICRODUCK_BW_UNDOCK_CRITIC="1")
+    assert cfg.rewards["undock_progress"].weight == 1.0            # undock_progress is >= 0 for moving out: positive weight
+    assert "undock" in cfg.observations["critic"].terms and "undock" not in cfg.observations["actor"].terms   # actor stays 61D
