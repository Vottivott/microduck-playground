+def test_curriculum_cap_drops_the_inherited_hardening_only(monkeypatch):
+    monkeypatch.delenv("MICRODUCK_BW_CURRICULUM_CAP", raising=False)
+    knobs = dict(MICRODUCK_BW_UNDOCK="0.3", MICRODUCK_BW_UNDOCK_F="0:0.5-1.5,1600:2-6")
+    cfg = _cfg(monkeypatch, **knobs)
+    assert any(s["step"] == 1500*24 for s in cfg.curriculum["head_pose_range"].params["range_stages"])   # off by default
+    cfg = _cfg(monkeypatch, MICRODUCK_BW_CURRICULUM_CAP="1499", **knobs)
+    for name, term in cfg.curriculum.items():
+        if name in ("seat_friction_range", "undock_magnet"):
+            continue
+        for k, stages in term.params.items():
+            if k.endswith("_stages"):
+                assert stages and all(s["step"] < 1499*24 for s in stages), name
+    assert cfg.curriculum["action_rate_weight"].params["weight_stages"][-1] == {"step": 1250*24, "weight": -0.8}
+    assert [s["weight"] for s in cfg.curriculum["rise_speed_weight"].params["weight_stages"]] == [0.0]
+    assert cfg.curriculum["undock_magnet"].params["param_stages"][-1]["step"] == 1600*24        # the magnet still grows
+    assert cfg.curriculum["seat_friction_range"].params["param_stages"][-1]["step"] == 1500*24
+
