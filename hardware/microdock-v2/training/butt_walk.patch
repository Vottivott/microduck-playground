+def test_undocking_events_and_magnet_curriculum(monkeypatch):
+    cfg = _cfg(monkeypatch, MICRODUCK_BW_UNDOCK="0.3", MICRODUCK_BW_UNDOCK_F="0:0.5-1.5,300:1-3")
+    r, f = cfg.events["undock_reset"], cfg.events["undock_forces"]
+    assert r.mode == "reset" and r.params["prob"] == 0.3 and r.params["fmax_range"] == (0.5, 1.5)
+    assert f.mode == "step" and f.params["asset_cfg"].body_names == ("trunk_base",)
+    assert cfg.curriculum["undock_magnet"].params["param_stages"] == [
+        {"step": 0, "params": {"fmax_range": (0.5, 1.5)}}, {"step": 300*24, "params": {"fmax_range": (1.0, 3.0)}}]
+    assert list(cfg.events).index("undock_reset") > list(cfg.events).index("reset_base")   # after the robot's own reset
