+def test_magnet_pulls_back_and_the_adapter_face_pushes_out():
+    import torch
+    from mjlab_microduck.tasks.mdp import magnet_axial_force, hood_ceiling
+    f = magnet_axial_force(torch.tensor([-3.0, 0.0, 1.0, 2.0, 4.5]), torch.tensor(4.0))
+    assert torch.allclose(f[1:], torch.tensor([-4.0, -4.0, -3.0, 0.0]))       # full pull to 1 mm, gone past 4 mm
+    assert f[0] > 0                                                           # pressed 3 mm into the face: 6 N out, 4 N in
+    moving_in = magnet_axial_force(torch.tensor([-1.0]), torch.tensor(0.0), v_axis=torch.tensor([-0.05]))
+    assert moving_in[0] > 2000*1e-3*1.0                                       # the stop leads: it already pushes for -1.5 mm
+    z = hood_ceiling(torch.tensor([0.0, 24.5, 28.0]), torch.tensor(0.062))
+    assert torch.allclose(z, torch.tensor([0.068, 0.071, 0.074]))            # 6 mm of lift, then the lip's 6 mm ramp
+
