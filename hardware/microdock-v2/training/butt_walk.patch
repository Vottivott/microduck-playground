+def test_straight_resample_and_yaw_cost_values():
+    import torch
+    from types import SimpleNamespace
+    from mjlab_microduck.tasks.mdp import VelocityCommandCommandOnly, VelocityCommandCommandOnlyCfg, yaw_rate_error_l1
+    cfg = SimpleNamespace(rel_straight_envs=1.0, straight_min_speed=0.02, straight_backward_frac=0.75,
+                          ranges=SimpleNamespace(lin_vel_x=(-0.10, 0.06)))
+    n = 4000
+    cmd = SimpleNamespace(cfg=cfg, device="cpu", vel_command_b=torch.full((n, 3), 0.3), vel_command_w=torch.zeros(n, 3),
+                          is_standing_env=torch.ones(n, dtype=torch.bool))
+    VelocityCommandCommandOnly._resample_straight(cmd, torch.arange(n))
+    vx = cmd.vel_command_b[:, 0]
+    assert (cmd.vel_command_b[:, 1:] == 0).all() and not cmd.is_standing_env.any()
+    assert (vx.abs() >= 0.02 - 1e-6).all() and vx.min() >= -0.10 and vx.max() <= 0.06
+    assert 0.7 < (vx < 0).float().mean() < 0.8
+    import dataclasses
+    assert {f.name: f.default for f in dataclasses.fields(VelocityCommandCommandOnlyCfg)}["rel_straight_envs"] == 0.0   # off unless asked for
+    env = SimpleNamespace(scene={"robot": SimpleNamespace(data=SimpleNamespace(root_link_ang_vel_b=torch.tensor([[0, 0, 0.5], [0, 0, -3.0]])))},
+                          command_manager=SimpleNamespace(get_command=lambda name: torch.tensor([[0, 0, 0.0], [0, 0, 0.2]])))
+    assert torch.allclose(yaw_rate_error_l1(env), torch.tensor([-0.5, -1.0]))         # capped at 1 rad/s
