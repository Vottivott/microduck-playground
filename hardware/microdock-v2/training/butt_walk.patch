+def test_hood_holds_the_heading_near_the_dock_only():
+    import math
+    import torch
+    from mjlab_microduck.tasks.mdp import hood_yaw_torque
+    d = torch.deg2rad(torch.tensor([2.0, 10.0, -10.0, 8.0, 30.0]))
+    t = hood_yaw_torque(d, torch.zeros(5), torch.tensor([0.0, 0.0, 0.0, 11.0, 25.0]))
+    assert t[0] == 0 and t[3] == 0 and t[4] == 0          # within the play docked (3 deg), 11 mm out (10 deg); free past 20 mm
+    assert t[1] < 0 and torch.isclose(t[1], -t[2])        # turned 10 deg docked: turned back, either way
+    assert torch.isclose(t[1], torch.tensor(-2.0*math.radians(7.0)), atol=1e-5)
+    leading = hood_yaw_torque(torch.deg2rad(torch.tensor([2.9])), torch.tensor([2.0]), torch.tensor([0.0]))
+    assert leading[0] < 0                                 # the stop leads: at 2.9 deg turning at 2 rad/s it already holds
+
