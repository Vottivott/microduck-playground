@@ -0,0 +1,165 @@
+"""Butt walk cfg invariants: the default recipe has no hip costs (the released policy's), and the hip-limit and
+leg-torque costs are negative-weighted, scoped to the right joints and staged as set."""
+import importlib
+import re
+
+MOD = "mjlab_microduck.tasks.microduck_butt_walk_env_cfg"
+LEGS = [f"{s}_{j}" for s in ("left", "right") for j in ("hip_yaw", "hip_roll", "hip_pitch", "knee", "ankle")]
+HEAD = ["neck_pitch", "head_pitch", "head_yaw", "head_roll"]
+PASSIVE = ["passive_backlash_left_knee", "passive_left_wheel"]
+
+
+def _cfg(monkeypatch, **env):
+    for k in ("MICRODUCK_BW_HIP_LIMIT", "MICRODUCK_BW_HIP_LIMIT_MARGIN", "MICRODUCK_BW_TORQUE"):
+        monkeypatch.delenv(k, raising=False)
+    for k, v in env.items():
+        monkeypatch.setenv(k, v)
+    return importlib.reload(importlib.import_module(MOD)).make_microduck_butt_walk_env_cfg()
+
+
+def test_default_recipe_has_no_hip_costs(monkeypatch):
+    cfg = _cfg(monkeypatch)
+    assert "hip_limit_proximity" not in cfg.rewards
+    assert "leg_torques" not in cfg.rewards and "leg_torques_weight" not in cfg.curriculum
+
+
+def test_hip_limit_cost_is_negative_and_hips_only(monkeypatch):
+    t = _cfg(monkeypatch, MICRODUCK_BW_HIP_LIMIT="3").rewards["hip_limit_proximity"]
+    assert t.weight == -3.0 and t.params["margin"] == 0.15          # joint_pos_limit_proximity returns a cost >= 0
+    pat = t.params["asset_cfg"].joint_names[0]
+    assert [j for j in LEGS + HEAD + PASSIVE if re.match(pat, j)] == [
+        "left_hip_yaw", "left_hip_roll", "right_hip_yaw", "right_hip_roll"]
+
+
+def test_leg_torque_cost_is_staged_negative_and_legs_only(monkeypatch):
+    cfg = _cfg(monkeypatch, MICRODUCK_BW_TORQUE="500:0.2,900:0.5")
+    t = cfg.rewards["leg_torques"]
+    assert t.weight == 0.0                                           # off until iteration 500
+    assert cfg.curriculum["leg_torques_weight"].params["weight_stages"] == [
+        {"step": 500*24, "weight": -0.2}, {"step": 900*24, "weight": -0.5}]
+    pat = t.params["asset_cfg"].actuator_names[0]
+    assert [j for j in LEGS + HEAD + PASSIVE if re.match(pat, j)] == LEGS
+
+
+def test_leg_torque_cost_from_the_start(monkeypatch):
+    assert _cfg(monkeypatch, MICRODUCK_BW_TORQUE="0:0.5").rewards["leg_torques"].weight == -0.5
+
