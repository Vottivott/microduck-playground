+def test_undock_progress_is_paid_back_when_an_episode_terminates():
+    import torch
+    from types import SimpleNamespace
+    from mjlab_microduck.tasks.mdp import undock_progress
+    env = SimpleNamespace(num_envs=3, device="cpu", step_dt=0.02,
+                          _undock=dict(gap=torch.tensor([5.0, 5.0, 20.0]), gap_prev=torch.tensor([4.0, 4.0, 11.0])),
+                          termination_manager=SimpleNamespace(terminated=torch.tensor([False, True, False])))
+    r = undock_progress(env)*env.step_dt                                      # what an episode sums (x weight)
+    assert torch.allclose(r, torch.tensor([1.0, 1.0 - 5.0, 12.0 - 11.0]))     # +1 mm; a fall gives back all 5 mm; clipped at 12
+
